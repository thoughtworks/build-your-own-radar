{
  "name": "build-your-own-radar",
  "version": "1.2.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:dev": "webpack --mode development --config webpack.dev.js",
    "build:prod": "webpack --mode production --config webpack.prod.js",
    "dev": "webpack-dev-server --mode development --config webpack.dev.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress open --env host=$TEST_URL",
    "test:e2e-headless": "cypress run --browser chrome --record false --env host=$TEST_URL",
    "lint-prettier:check": "eslint . && prettier --check .",
    "lint-prettier:fix": "eslint . --fix && prettier --write .",
    "quality": "npm run lint-prettier:check && npm run test:coverage"
  },
  "author": "Thoughtworks",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoughtworks/build-your-own-radar"
  },
  "keywords": [
    "tech-radar"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "cssnano": "^8.0.10",
    "cypress": "^15.21.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-jest": "^29.16.2",
    "expose-loader": "^5.0.1",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "jest-css-modules-transform": "^4.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "mochawesome": "^8.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.110.0",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "yargs": "^17.7.3"
  },
  "dependencies": {
    "chance": "^1.1.13",
    "d3": "^7.9.0",
    "d3-tip": "^0.9.1",
    "jquery": "^4.0.0",
